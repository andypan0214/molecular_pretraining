
from pathlib import Path
import os

# ============================================================
# HEART / Ugi-4CR / LNPDB — HPC Path Configuration
# ============================================================

# 1. Project storage
PROJECT_ROOT = Path("/project/yli4/ypan")
LIPID_LIBRARY_ROOT = PROJECT_ROOT / "lipid_library"
INPUT_DIR = LIPID_LIBRARY_ROOT / "input"

# 2. Input datasets
LNPDB_PATH = INPUT_DIR / "LNPDB.csv"
LUMI_LIBRARY_PATH = (
    INPUT_DIR / "LUMI_virtual_library_training_lipidLike.xlsx"
)

# 3. Existing Ugi-4CR molecular library
UGI_LMDB_DIR = LIPID_LIBRARY_ROOT / "lmdb"

# 4. Existing HEART model directory
HOME = Path.home()
MODEL_TRAIN_DIR = HOME / "heart_liver" / "model_train"

# 5. Previously completed Priority 1 audit
PRIORITY1_RESULTS = (
    MODEL_TRAIN_DIR / "ugi_priority1_interactive_evidence"
)

PRIORITY1_DECISION = (
    PRIORITY1_RESULTS / "07_priority1_evidence_decision.json"
)

PRIORITY1_MOLECULAR_AUDIT = (
    PRIORITY1_RESULTS / "03_full_molecular_audit.json"
)

# 6. Priority 2 output directory
PRIORITY2_RESULTS = (
    MODEL_TRAIN_DIR / "ugi_lnpdb_priority2_evidence"
)

PRIORITY2_RESULTS.mkdir(
    parents=True,
    exist_ok=True
)

# ============================================================
# Validate paths before running any analysis
# ============================================================

required_files = {
    "LNPDB CSV": LNPDB_PATH,
    "LUMI virtual library": LUMI_LIBRARY_PATH,
    "Priority 1 molecular audit": PRIORITY1_MOLECULAR_AUDIT,
    "Priority 1 decision": PRIORITY1_DECISION,
}

required_directories = {
    "Ugi LMDB directory": UGI_LMDB_DIR,
    "HEART model directory": MODEL_TRAIN_DIR,
}

print("=" * 65)
print("HEART / LNPDB / Ugi-4CR — Path Verification")
print("=" * 65)

missing = []

for name, path in required_files.items():
    exists = path.is_file()
    print(f"{name}: {'FOUND' if exists else 'MISSING'}")
    print(f"  {path}")
    if not exists:
        missing.append(str(path))

for name, path in required_directories.items():
    exists = path.is_dir()
    print(f"{name}: {'FOUND' if exists else 'MISSING'}")
    print(f"  {path}")
    if not exists:
        missing.append(str(path))

print("\nOutput directory:")
print(PRIORITY2_RESULTS)

if missing:
    print("\nWARNING: Some required paths were not found.")
    for path in missing:
        print(" -", path)
else:
    print("\nAll required paths verified successfully.")

