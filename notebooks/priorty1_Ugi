"""Shared editorial figure settings for HEART Ugi-4CR / LNPDB validation.

Figures display measured input values only. Export PNG (300 dpi) and editable SVG.
"""
from pathlib import Path
import os
import matplotlib as mpl
import matplotlib.pyplot as plt

COLORS = {
    "dark": "#344054", "muted": "#667085", "grid": "#E7E9EF",
    "ugi": "#D99A35", "ugi_light": "#F7DE9D", "ugi_deep": "#9D681A",
    "novel": "#B95860", "novel_light": "#F0B6A2", "novel_deep": "#883D56",
    "valid": "#557A79", "valid_light": "#A4C7BC",
    "neutral": "#A9AFB9", "background": "#FFFFFF",
}

def set_style():
    mpl.rcParams.update({
        "font.family": "DejaVu Sans", "font.size": 8.5,
        "axes.titlesize": 9.5, "axes.labelsize": 8,
        "xtick.labelsize": 7.5, "ytick.labelsize": 7.5,
        "legend.fontsize": 7.4,
        "axes.spines.top": False, "axes.spines.right": False,
        "axes.titleweight": "semibold", "axes.edgecolor": COLORS["grid"],
        "axes.labelcolor": COLORS["dark"], "text.color": COLORS["dark"],
        "xtick.color": COLORS["muted"], "ytick.color": COLORS["muted"],
        "axes.facecolor": "white", "figure.facecolor": "white",
        "grid.color": COLORS["grid"], "grid.alpha": 0.7,
        "svg.fonttype": "none", "pdf.fonttype": 42,
        "savefig.facecolor": "white", "savefig.dpi": 300,
    })

def label_panel(ax, letter):
    ax.text(-0.105, 1.085, letter, transform=ax.transAxes, fontweight="bold",
            fontsize=12, color="black", va="top", ha="left", clip_on=False)

def export(fig, destination: Path):
    destination = Path(destination)
    destination.parent.mkdir(parents=True, exist_ok=True)
    for ext in ("png", "svg"):
        fig.savefig(destination.with_suffix("." + ext), dpi=300,
                    facecolor="white", bbox_inches="tight", pad_inches=0.15)
    plt.close(fig)
    return [str(destination.with_suffix("." + ext)) for ext in ("png", "svg")]

C = COLORS


"""Build a six-panel Priority-1 research-quality figure from completed HPC audit evidence.

This is a *read-only visualization*, NOT a rerun of the 15.18M-molecule audit.
Panels deliberately distinguish 100% metadata verification from the sampled LMDB probe.
"""
import json
from pathlib import Path
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter

DEFAULT_AUDIT = Path.home() / 'heart_liver/model_train/ugi_priority1_interactive_evidence'

def read(path):
    if not path.is_file():
        raise FileNotFoundError(f'Missing completed audit evidence: {path}')
    return json.loads(path.read_text(encoding='utf-8'))

def build(audit: Path, out: Path):
    full = read(audit/'03_full_molecular_audit.json')
    side = read(audit/'02_3d_index_census.json')
    lmdb = read(audit/'05_real_lmdb_probe_summary.json')
    decision = read(audit/'07_priority1_evidence_decision.json')
    if full.get('scope') != 'FULL' or side.get('scope') != 'FULL_VIEW_SCAN':
        raise RuntimeError('Full audit and full sidecar index census required. No partial figure.')
    total = int(full['audited_records']); shards = int(full['audited_shards'])
    if total != int(full['expected_records']) or shards != int(full['expected_shards']):
        raise RuntimeError('Audit coverage is incomplete.')
    if int(side['counted_records']) != total:
        raise RuntimeError('Sidecar census and metadata record totals disagree.')
    n3 = {int(k):int(v) for k,v in full['n3d_histogram'].items()}
    heavy = {int(k):int(v) for k,v in full['heavy_atom_histogram_cap513'].items()}
    unique = int(full['unique_canonical_molecules_hash_based'])
    dup = int(full['duplicate_excess_records'])
    cross = int(full['canonical_train_valid_intersection'])
    probe_count = int(lmdb.get('actual_probes', 0))
    probe_err = int(lmdb.get('errors', 0))
    anomalies = full.get('issues_full_counts',{})
    set_style()
    fig = plt.figure(figsize=(13.4, 9.4), constrained_layout=False)
    gs = fig.add_gridspec(2, 3, left=.065,right=.97, bottom=.075,top=.86,
                          wspace=.36,hspace=.5)
    ax = [fig.add_subplot(gs[i,j]) for i in range(2) for j in range(3)]
    fig.suptitle('Structural and 3D readiness of the HEART Ugi-4CR virtual library',
                 x=.065, y=.955, ha='left', fontsize=16, fontweight='bold', color=C['dark'])
    fig.text(.065,.915,f'Full metadata census  |  {total:,} records  |  {shards:,} shards  |  LMDB payload probe n={probe_count:,}',
             fontsize=9.2, color=C['muted'])

    # a — verified 3D success in original LMDB Stage-06 sidecars.
    a=ax[0]; xs=np.arange(1,11); ys=np.array([n3.get(int(k),0) for k in xs], dtype=float)
    a.bar(xs, ys/total*100, color=C['ugi'],width=.79)
    a.set(title='Validated 3D conformers per molecule', xlabel='Successful 3D slots', ylabel='Share of records (%)')
    a.set_xticks(xs); a.grid(axis='y');a.set_axisbelow(True)
    a.text(.04,.95,f'{int(sum(n3.values())):,} indexed records',transform=a.transAxes,va='top',fontsize=7.7,color=C['muted']);label_panel(a,'a')

    # b — molecular size; tail (>512) is explicitly retained as overflow.
    a=ax[1]; ks=sorted(k for k in heavy if k != 513)
    a.plot(ks,[heavy[k]/total*100 for k in ks],color=C['ugi_deep'],lw=1.9)
    a.fill_between(ks,[heavy[k]/total*100 for k in ks],color=C['ugi_light'],alpha=.65)
    a.set(title='Molecular size distribution',xlabel='Heavy-atom count',ylabel='Share of records (%)')
    a.grid(axis='y');a.set_axisbelow(True)
    if 513 in heavy and heavy[513] > 0:
        a.text(.98,.94,f'>512 atoms: {heavy[513]:,}',ha='right',va='top',transform=a.transAxes,fontsize=7.5)
    label_panel(a,'b')

    # c — molecular identity is not conflated with downstream generalization.
    a=ax[2];a.barh(['Unique\nidentities','Duplicate excess','Train–valid\nexact overlap'],
                     [unique,dup,cross],color=[C['ugi'],C['novel'],C['novel_deep']],height=.6)
    a.invert_yaxis();a.set(title='Canonical molecular identity',xlabel='Molecular identities / records')
    a.xaxis.set_major_formatter(FuncFormatter(lambda x,pos: f'{x/1e6:.0f}M' if x>=1e6 else f'{x:,.0f}'))
    for i,v in enumerate([unique,dup,cross]):
        a.text(v + max(unique*.012,1),i,f'{v:,}',va='center',fontsize=7.6)
    a.set_xlim(0, max(1,unique)*1.19);a.grid(axis='x');a.set_axisbelow(True);label_panel(a,'c')

    # d — explicit anomaly categories (including measured zero), not a fake feature space.
    a=ax[3];keys=['invalid_smiles','fragmented_smiles','bad_3d_count','sidecar_disagreement','noncontiguous_keys']
    labels=['Invalid SMILES','Fragmented structures','Invalid 3D count','Index disagreement','Noncontiguous keys']
    values=[int(anomalies.get(k,0)) for k in keys]
    a.barh(labels,values,color=[C['valid'] if v==0 else C['novel'] for v in values],height=.63)
    a.invert_yaxis();a.set(title='Full-scan QC anomalies',xlabel='Affected records')
    a.set_xlim(0,max(1,max(values,default=0))*1.3)
    for j,v in enumerate(values):a.text(v + .02*max(1,max(values)),j,str(v),va='center',fontsize=8)
    a.grid(axis='x');a.set_axisbelow(True);label_panel(a,'d')

    # e — survey type evidence vs sampling scope.
    a=ax[4];a.axis('off');label_panel(a,'e');a.set_title('Evidence coverage',loc='left',pad=10)
    rows=[('Metadata records audited',f'{total:,} / {int(full["expected_records"]):,}'),
          ('Stage-06 sidecar indexed',f'{int(side["counted_records"]):,} / {total:,}'),
          ('LMDB payloads inspected',f'{probe_count:,} sampled'),
          ('LMDB probe errors',f'{probe_err:,}')]
    for j,(k,v) in enumerate(rows):
        yy=.89-j*.22
        a.text(.03,yy,k,transform=a.transAxes,fontsize=8.1,va='top')
        a.text(.97,yy-.082,v,transform=a.transAxes,ha='right',fontweight='semibold',fontsize=8.2,va='top')
        a.plot([.03,.97],[yy-.15,yy-.15],color=C['grid'],lw=1,transform=a.transAxes)

    # f — interpretation and honest downstream gate.
    a=ax[5];a.axis('off');label_panel(a,'f');a.set_title('Pretraining-readiness interpretation',loc='left',pad=10)
    data_gate=str(decision.get('data_gate','UNKNOWN'))
    production_gate=str(decision.get('production_gate','UNKNOWN'))
    notes=[('DATA GATE',data_gate,C['valid'] if data_gate=='GO_DATA' else C['novel']),
           ('PRODUCTION GATE',production_gate,C['novel_deep'])]
    for j,(k,v,col) in enumerate(notes):
        y=.83-j*.27
        a.text(.03,y,k,transform=a.transAxes,color=C['muted'],fontsize=7.5)
        a.text(.03,y-.1,v.replace('_',' '),transform=a.transAxes,color=col,fontweight='bold',fontsize=8.7)
    a.text(.03,.14,'Full metadata audit does not prove training-loader\n3D slot selection or LNP delivery performance.',
           transform=a.transAxes,color=C['muted'],fontsize=7.7,va='top')
    files=export(fig,out)
    info={'source_audit':str(audit),'input_gate':data_gate,'production_gate':production_gate,
          'full_records':total,'full_shards':shards,'unique_hash_based':unique,'duplicate_excess':dup,
          'canonical_train_valid_shared':cross,'sampled_lmdb_payloads':probe_count,'sampled_lmdb_errors':probe_err,
          'figure_files':files,'note':'Source-verified aggregate; no new QC performed.'}
    return info


from IPython.display import display, Image, Markdown

