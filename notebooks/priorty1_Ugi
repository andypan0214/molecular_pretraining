))
P1_FIGURE_PATH = P1_AUDIT_DIR / "figures/HEART_P1_research_composite"
p1_figure_evidence = build(P1_AUDIT_DIR, P1_FIGURE_PATH)
print("Completed Priority 1 figure:", P1_FIGURE_PATH.with_suffix(".png"))
print("Editable SVG:", P1_FIGURE_PATH.with_suffix(".svg"))
display(Image(filename=str(P1_FIGURE_PATH.with_suffix(".png"))))
